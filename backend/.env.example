# --- Core Django ---
SECRET_KEY=UsRtdVjPcAjA4gC6lnbuku9jPlcuua4tM3I3IXlxJ4N-vNs_eMt2SwRal7kg1xdgRfs              # generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True               # True locally, False in production (prod.py forces this anyway)
ALLOWED_HOSTS=localhost,127.0.0.1   # add your real domain when you deploy

# --- Database ---
DB_NAME=church_platform
DB_USER=postgres
DB_PASSWORD=             # your local Postgres password
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173   # your Vite dev server; add prod frontend URL later

# --- Stripe ---
STRIPE_SECRET_KEY=       # dashboard.stripe.com → Developers → API keys → Secret key (sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=   # created when you register a webhook endpoint (Developers → Webhooks) — needed to verify donation confirmations are really from Stripe

# --- M-Pesa Daraja ---
MPESA_CONSUMER_KEY=      # from your Daraja app on developer.safaricom.co.ke
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=         # Paybill/Till number (sandbox gives you a test one: 174379)
MPESA_PASSKEY=           # sandbox passkey is published on the Daraja docs; production one comes after go-live approval

# --- Turnstile (Cloudflare, spam protection on public forms) ---
TURNSTILE_SECRET_KEY=    # dash.cloudflare.com → Turnstile → add site → gives you site key (frontend) + secret key (backend)

# --- Cloudflare R2 (backups/media storage, prod only) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=          # https://<account_id>.r2.cloudflarestorage.com